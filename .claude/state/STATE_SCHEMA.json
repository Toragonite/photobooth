{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhotoBooth Agent State Schema",
  "description": "Unified state management for multi-agent PhotoBooth system",
  "version": "1.0.0",

  "definitions": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "healthStatus": {
      "type": "string",
      "enum": ["healthy", "warning", "critical", "unknown"]
    }
  },

  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "lastUpdated": { "$ref": "#/definitions/timestamp" },
        "updatedBy": { "type": "string" }
      },
      "required": ["version", "lastUpdated"]
    },

    "orchestrator": {
      "type": "object",
      "description": "Main orchestrator agent state",
      "properties": {
        "status": { "type": "string", "enum": ["idle", "processing", "error"] },
        "activeSubagents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": { "type": "string" },
              "name": { "type": "string" },
              "status": { "type": "string" },
              "startedAt": { "$ref": "#/definitions/timestamp" },
              "taskDescription": { "type": "string" }
            }
          }
        },
        "pendingTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": { "type": "string" },
              "type": { "type": "string" },
              "priority": { "type": "integer" },
              "createdAt": { "$ref": "#/definitions/timestamp" },
              "assignedTo": { "type": "string" }
            }
          }
        }
      }
    },

    "printQueue": {
      "type": "object",
      "description": "Print manager agent state",
      "properties": {
        "activeJobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobId": { "type": "string" },
              "sessionId": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["pending", "processing", "printing", "completed", "failed", "cancelled"]
              },
              "copies": { "type": "integer", "minimum": 1, "maximum": 3 },
              "retryCount": { "type": "integer" },
              "maxRetries": { "type": "integer" },
              "lastError": { "type": "string" },
              "createdAt": { "$ref": "#/definitions/timestamp" },
              "startedAt": { "$ref": "#/definitions/timestamp" },
              "completedAt": { "$ref": "#/definitions/timestamp" }
            },
            "required": ["jobId", "sessionId", "status"]
          }
        },
        "queuedJobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobId": { "type": "string" },
              "sessionId": { "type": "string" },
              "position": { "type": "integer" },
              "copies": { "type": "integer" }
            }
          }
        },
        "circuitBreaker": {
          "type": "object",
          "properties": {
            "state": { "type": "string", "enum": ["closed", "open", "half_open"] },
            "failureCount": { "type": "integer" },
            "lastFailureAt": { "$ref": "#/definitions/timestamp" },
            "nextRetryAt": { "$ref": "#/definitions/timestamp" }
          }
        },
        "statistics": {
          "type": "object",
          "properties": {
            "todayTotal": { "type": "integer" },
            "todayCompleted": { "type": "integer" },
            "todayFailed": { "type": "integer" },
            "successRate": { "type": "number" }
          }
        }
      }
    },

    "systemHealth": {
      "type": "object",
      "description": "Sensor monitor agent state",
      "properties": {
        "overall": { "$ref": "#/definitions/healthStatus" },
        "lastCheck": { "$ref": "#/definitions/timestamp" },
        "components": {
          "type": "object",
          "properties": {
            "printer": {
              "type": "object",
              "properties": {
                "status": { "$ref": "#/definitions/healthStatus" },
                "cupsStatus": { "type": "string" },
                "paperLevel": { "type": "integer", "minimum": 0, "maximum": 100 },
                "inkLevel": { "type": "integer", "minimum": 0, "maximum": 100 },
                "errorCode": { "type": "string" }
              }
            },
            "camera": {
              "type": "object",
              "properties": {
                "status": { "$ref": "#/definitions/healthStatus" },
                "connected": { "type": "boolean" },
                "resolution": { "type": "string" },
                "lastCapture": { "$ref": "#/definitions/timestamp" }
              }
            },
            "storage": {
              "type": "object",
              "properties": {
                "status": { "$ref": "#/definitions/healthStatus" },
                "totalBytes": { "type": "integer" },
                "usedBytes": { "type": "integer" },
                "freeBytes": { "type": "integer" },
                "percentUsed": { "type": "number" }
              }
            },
            "system": {
              "type": "object",
              "properties": {
                "status": { "$ref": "#/definitions/healthStatus" },
                "cpuTempCelsius": { "type": "number" },
                "memoryPercent": { "type": "number" },
                "uptimeSeconds": { "type": "integer" }
              }
            },
            "network": {
              "type": "object",
              "properties": {
                "status": { "$ref": "#/definitions/healthStatus" },
                "wifiApActive": { "type": "boolean" },
                "connectedClients": { "type": "integer" },
                "ssid": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "activeSessions": {
      "type": "object",
      "description": "Active photo booth sessions",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["active", "capturing", "previewing", "printing", "complete", "abandoned"]
              },
              "language": { "type": "string", "enum": ["ko", "en"] },
              "photoCount": { "type": "integer", "minimum": 0, "maximum": 4 },
              "createdAt": { "$ref": "#/definitions/timestamp" },
              "lastActivityAt": { "$ref": "#/definitions/timestamp" }
            }
          }
        },
        "totalToday": { "type": "integer" },
        "completedToday": { "type": "integer" }
      }
    },

    "backgroundTasks": {
      "type": "object",
      "description": "Background task tracking",
      "properties": {
        "running": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskId": { "type": "string" },
              "agentName": { "type": "string" },
              "command": { "type": "string" },
              "pid": { "type": "integer" },
              "status": { "type": "string", "enum": ["running", "completed", "failed"] },
              "startedAt": { "$ref": "#/definitions/timestamp" },
              "completedAt": { "$ref": "#/definitions/timestamp" },
              "outputFile": { "type": "string" }
            }
          }
        },
        "completed": {
          "type": "array",
          "items": { "$ref": "#/properties/backgroundTasks/properties/running/items" }
        }
      }
    }
  }
}
