# PhotoBooth Environment Configuration
# Copy this file to .env and customize as needed

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/photobooth.db

# Printer
PRINTER_MOCK_MODE=true

# Auto-discovery (recommended): Automatically detect Selphy printers from CUPS
# When enabled, printers matching PRINTER_NAME_PATTERN are discovered dynamically
PRINTER_AUTO_DISCOVER=true
PRINTER_NAME_PATTERN=Selphy

# Fallback printer name (used when auto-discovery finds nothing)
PRINTER_NAME=SelphyCP1500

# Manual printer list (overrides auto-discovery if set)
# Use JSON array format, e.g.: ["SelphyCP1500","SelphyCP1500-2"]
# PRINTER_NAMES=["SelphyCP1500","SelphyCP1500-2"]

# Selection strategy for multiple printers:
#   - least-busy: Pick printer with shortest queue (default, recommended)
#   - round-robin: Alternate between printers
#   - failover: Use first available printer in order
PRINTER_SELECTION_STRATEGY=least-busy

# Security
SECRET_KEY=change-me-to-a-random-secure-string
ADMIN_PIN=1998

# Network (for Raspberry Pi AP mode)
WIFI_SSID=photobooth
WIFI_PASSWORD=photobooth-1998
WIFI_CHANNEL=6

# System
TIMEZONE=Africa/Kigali
AUTO_CLEANUP_DAYS=30
