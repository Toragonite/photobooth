# PhotoBooth Environment Configuration
# Copy this file to .env and set all required values before deployment
#
# SECURITY WARNING: Never commit .env file with real secrets to version control
# Generate secure values using: openssl rand -base64 32

# =============================================================================
# REQUIRED - You MUST set these before running
# =============================================================================

# Security (REQUIRED)
# Generate with: openssl rand -base64 32
SECRET_KEY=

# Admin PIN (REQUIRED) - 4-8 digit numeric PIN for admin access
ADMIN_PIN=

# Wi-Fi Access Point (REQUIRED for Raspberry Pi deployment)
WIFI_SSID=photobooth
WIFI_PASSWORD=

# =============================================================================
# OPTIONAL - These have sensible defaults but can be customized
# =============================================================================

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/photobooth.db

# Printer
PRINTER_MOCK_MODE=true
PRINTER_NAME=Canon_Selphy_CP1500

# Network (for Raspberry Pi AP mode)
WIFI_CHANNEL=6
PI_IP=192.168.4.1
DHCP_RANGE_START=192.168.4.10
DHCP_RANGE_END=192.168.4.50
COUNTRY_CODE=RW

# System
TIMEZONE=Africa/Kigali
AUTO_CLEANUP_DAYS=30
