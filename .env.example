# PhotoBooth Environment Configuration
# Copy this file to .env and customize as needed

# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/photobooth.db

# Printer
PRINTER_MOCK_MODE=true
PRINTER_NAME=SelphyCP1500
# For multiple printers (comma-separated JSON array), e.g.: ["Selphy1","Selphy2"]
# PRINTER_NAMES=["Selphy1","Selphy2"]
# Strategy: round-robin | least-busy | failover
# PRINTER_SELECTION_STRATEGY=least-busy

# Security
SECRET_KEY=change-me-to-a-random-secure-string
ADMIN_PIN=1998

# Network (for Raspberry Pi AP mode)
WIFI_SSID=photobooth
WIFI_PASSWORD=photobooth-1998
WIFI_CHANNEL=6

# System
TIMEZONE=Africa/Kigali
AUTO_CLEANUP_DAYS=30
